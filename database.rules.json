{
  "rules": {
    ".read": false,
    ".write": false,
    "presenceAcl": {
      "$tripId": {
        "$uid": {
          ".read": false,
          ".write": false
        }
      }
    },
    "tripRealtimeAcl": {
      "$tripId": {
        "$uid": {
          ".read": false,
          ".write": false
        }
      }
    },
    "tripPresence": {
      "$tripId": {
        ".read": "auth != null && root.child('presenceAcl/' + $tripId + '/' + auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid && root.child('presenceAcl/' + $tripId + '/' + auth.uid).exists()",
          "profile": {
            ".validate": "newData.hasChildren(['uid', 'displayName', 'email'])",
            "uid": {
              ".validate": "newData.isString() && newData.val() == auth.uid"
            },
            "displayName": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "email": {
              ".validate": "newData.isString() && newData.val().length <= 240"
            },
            "photoURL": {
              ".validate": "newData.isString() && newData.val().length <= 1000"
            },
            "$other": {
              ".validate": false
            }
          },
          "connections": {
            "$clientId": {
              ".validate": "newData.hasChildren(['state', 'activeTab', 'editingTarget', 'startedAt', 'lastActiveAt'])",
              "state": {
                ".validate": "newData.isString() && newData.val() == 'online'"
              },
              "activeTab": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "editingTarget": {
                ".validate": "newData.isString() && newData.val().length <= 160"
              },
              "startedAt": {
                ".validate": "newData.isNumber()"
              },
              "lastActiveAt": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "tripRealtime": {
      "$tripId": {
        ".read": "auth != null && root.child('tripRealtimeAcl/' + $tripId + '/' + auth.uid).exists()",
        "editing": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('tripRealtimeAcl/' + $tripId + '/' + auth.uid).exists()",
            ".validate": "newData.hasChildren(['target', 'activeTab', 'updatedAt'])",
            "target": {
              ".validate": "newData.isString() && newData.val().length <= 160"
            },
            "label": {
              ".validate": "newData.isString() && newData.val().length <= 160"
            },
            "activeTab": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "checklistStatus": {
          "$listId": {
            "$itemId": {
              "$uid": {
                ".write": "auth != null && auth.uid == $uid && (root.child('tripRealtimeAcl/' + $tripId + '/' + auth.uid + '/role').val() == 'owner' || root.child('tripRealtimeAcl/' + $tripId + '/' + auth.uid + '/role').val() == 'editor')",
                ".validate": "newData.hasChildren(['done', 'updatedAt'])",
                "done": {
                  ".validate": "newData.isBoolean()"
                },
                "updatedAt": {
                  ".validate": "newData.isNumber()"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          }
        },
        "shoppingStatus": {
          "$itemId": {
            "$uid": {
              ".write": "auth != null && auth.uid == $uid && (root.child('tripRealtimeAcl/' + $tripId + '/' + auth.uid + '/role').val() == 'owner' || root.child('tripRealtimeAcl/' + $tripId + '/' + auth.uid + '/role').val() == 'editor')",
              ".validate": "newData.hasChildren(['purchased', 'updatedAt'])",
              "purchased": {
                ".validate": "newData.isBoolean()"
              },
              "updatedAt": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "placeVotes": {
          "$placeId": {
            ".write": false
          }
        },
        "activityLog": {
          "$activityId": {
            ".write": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
