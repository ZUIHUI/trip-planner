rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function primaryOwnerEmail() {
      return 'sky32439@gmail.com';
    }

    function isPrimaryOwner() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == primaryOwnerEmail();
    }

    function tripPath(tripId) {
      return /databases/$(database)/documents/trips/$(tripId);
    }

    function memberPath(tripId, uid) {
      return /databases/$(database)/documents/trips/$(tripId)/members/$(uid);
    }

    function hasOwner(data) {
      return data.keys().hasAny(['access'])
        && data.access.keys().hasAny(['ownerUid'])
        && data.access.ownerUid is string
        && data.access.ownerUid != '';
    }

    function isOwnedByCurrentUser(data) {
      return signedIn()
        && hasOwner(data)
        && data.access.ownerUid == request.auth.uid;
    }

    function isTripOwner(tripId) {
      return signedIn()
        && isOwnedByCurrentUser(get(tripPath(tripId)).data);
    }

    function isTripOwnerAfter(tripId) {
      return signedIn()
        && isOwnedByCurrentUser(getAfter(tripPath(tripId)).data);
    }

    function memberRole(tripId) {
      return get(memberPath(tripId, request.auth.uid)).data.role;
    }

    function isTripMember(tripId) {
      return signedIn() && exists(memberPath(tripId, request.auth.uid));
    }

    function isTripEditor(tripId) {
      return isTripMember(tripId)
        && (memberRole(tripId) == 'editor' || memberRole(tripId) == 'edit');
    }

    function optionalString(data, key, maxLength) {
      return !data.keys().hasAny([key])
        || (data[key] is string && data[key].size() <= maxLength);
    }

    function optionalNumber(data, key) {
      return !data.keys().hasAny([key]) || data[key] is number;
    }

    function optionalBool(data, key) {
      return !data.keys().hasAny([key]) || data[key] is bool;
    }

    function validUserProfile(data) {
      return data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'providerIds',
          'createdAt',
          'updatedAt'
        ])
        && data.uid == request.auth.uid
        && optionalString(data, 'email', 240)
        && optionalString(data, 'displayName', 120)
        && optionalString(data, 'photoURL', 1000);
    }

    function validMember(data, uid) {
      return data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'role',
          'shareToken',
          'inviteId',
          'inviteCode',
          'joinedAt',
          'updatedAt',
          'source'
        ])
        && data.uid == uid
        && (data.role in ['owner', 'editor', 'edit', 'view'])
        && optionalString(data, 'email', 240)
        && optionalString(data, 'displayName', 120)
        && optionalString(data, 'photoURL', 1000)
        && optionalString(data, 'shareToken', 200)
        && optionalString(data, 'inviteId', 120)
        && optionalString(data, 'inviteCode', 16)
        && optionalString(data, 'source', 80);
    }

    function validMeta(meta) {
      return meta is map
        && optionalString(meta, 'title', 160)
        && optionalString(meta, 'status', 40)
        && optionalString(meta, 'coverImage', 4000)
        && (!meta.keys().hasAny(['dateRange']) || meta.dateRange is map);
    }

    function validAccess(access) {
      return access is map
        && optionalString(access, 'ownerUid', 160)
        && optionalString(access, 'ownerEmail', 240)
        && optionalString(access, 'ownerName', 120)
        && optionalString(access, 'migratedAt', 80);
    }

    function validSyncMeta(syncMeta) {
      return syncMeta is map
        && optionalNumber(syncMeta, 'revision')
        && optionalString(syncMeta, 'updatedByUid', 160)
        && optionalString(syncMeta, 'updatedByClientId', 200)
        && optionalString(syncMeta, 'updatedByOperation', 80)
        && optionalString(syncMeta, 'updatedEntityId', 200)
        && optionalString(syncMeta, 'updatedAt', 80);
    }

    function validTripRoot(data) {
      return data.keys().hasOnly([
          'id',
          'schemaVersion',
          'meta',
          'logistics',
          'planning',
          'finance',
          'itineraryDays',
          'tripDetails',
          'itinerary',
          'placePool',
          'collaboration',
          'checklists',
          'expenses',
          'shoppingList',
          'shoppingCategories',
          'access',
          'syncMeta',
          'invite',
          'savedAt',
          'createdAt',
          'updatedAt'
        ])
        && optionalString(data, 'id', 200)
        && optionalNumber(data, 'schemaVersion')
        && (!data.keys().hasAny(['meta']) || validMeta(data.meta))
        && (!data.keys().hasAny(['access']) || validAccess(data.access))
        && (!data.keys().hasAny(['syncMeta']) || validSyncMeta(data.syncMeta));
    }

    function validTripDetailCommon(data, detailId) {
      return data.id == detailId
        && data.section == detailId
        && optionalNumber(data, 'schemaVersion')
        && optionalString(data, 'updatedAt', 80)
        && optionalString(data, 'updatedByUid', 160)
        && optionalString(data, 'updatedByClientId', 200);
    }

    function validTripMetaDetail(data, detailId) {
      return detailId == 'meta'
        && data.keys().hasOnly([
          'id',
          'section',
          'schemaVersion',
          'title',
          'status',
          'coverImage',
          'dateRange',
          'dates',
          'updatedAt',
          'updatedByUid',
          'updatedByClientId'
        ])
        && validTripDetailCommon(data, detailId)
        && optionalString(data, 'title', 160)
        && optionalString(data, 'status', 40)
        && optionalString(data, 'coverImage', 4000)
        && optionalString(data, 'dates', 120)
        && (!data.keys().hasAny(['dateRange']) || data.dateRange is map);
    }

    function validTripLogisticsDetail(data, detailId) {
      return detailId == 'logistics'
        && data.keys().hasOnly([
          'id',
          'section',
          'schemaVersion',
          'accommodation',
          'flights',
          'travelers',
          'updatedAt',
          'updatedByUid',
          'updatedByClientId'
        ])
        && validTripDetailCommon(data, detailId)
        && (!data.keys().hasAny(['accommodation']) || data.accommodation is map)
        && (!data.keys().hasAny(['flights']) || data.flights is map)
        && (!data.keys().hasAny(['travelers']) || data.travelers is list);
    }

    function validTripFinanceDetail(data, detailId) {
      return detailId == 'finance'
        && data.keys().hasOnly([
          'id',
          'section',
          'schemaVersion',
          'budget',
          'updatedAt',
          'updatedByUid',
          'updatedByClientId'
        ])
        && validTripDetailCommon(data, detailId)
        && (!data.keys().hasAny(['budget']) || data.budget is map);
    }

    function validTripDetail(data, detailId) {
      return validTripMetaDetail(data, detailId)
        || validTripLogisticsDetail(data, detailId)
        || validTripFinanceDetail(data, detailId);
    }

    function validTripSettingCommon(data, settingId) {
      return data.id == settingId
        && data.setting == settingId
        && optionalNumber(data, 'schemaVersion')
        && optionalString(data, 'updatedAt', 80)
        && optionalString(data, 'updatedByUid', 160)
        && optionalString(data, 'updatedByClientId', 200);
    }

    function validTripCollaborationSetting(data, settingId) {
      return settingId == 'collaboration'
        && data.keys().hasOnly([
          'id',
          'setting',
          'schemaVersion',
          'enabled',
          'shareToken',
          'permission',
          'votesEnabled',
          'createdAt',
          'updatedAt',
          'updatedByUid',
          'updatedByClientId'
        ])
        && validTripSettingCommon(data, settingId)
        && optionalBool(data, 'enabled')
        && optionalString(data, 'shareToken', 200)
        && (!data.keys().hasAny(['permission']) || data.permission in ['view', 'edit'])
        && optionalBool(data, 'votesEnabled')
        && optionalString(data, 'createdAt', 80);
    }

    function validTripSetting(data, settingId) {
      return validTripCollaborationSetting(data, settingId);
    }

    function validTripDay(data, dayId) {
      return data.keys().hasOnly([
          'id',
          'schemaVersion',
          'dayNumber',
          'title',
          'date',
          'weekday',
          'createdAt',
          'updatedAt',
          'updatedByUid',
          'updatedByClientId'
        ])
        && data.id == dayId
        && optionalNumber(data, 'schemaVersion')
        && optionalNumber(data, 'dayNumber')
        && optionalString(data, 'title', 200)
        && optionalString(data, 'date', 80)
        && optionalString(data, 'weekday', 40)
        && optionalString(data, 'createdAt', 80)
        && optionalString(data, 'updatedAt', 80)
        && optionalString(data, 'updatedByUid', 160)
        && optionalString(data, 'updatedByClientId', 200);
    }

    function validTripEvent(data) {
      return data.keys().hasOnly([
          'id',
          'schemaVersion',
          'dayNumber',
          'orderKey',
          'time',
          'type',
          'title',
          'desc',
          'location',
          'locationPlace',
          'urgent',
          'transport',
          'cost',
          'currency',
          'url',
          'memos',
          'deleted',
          'createdAt',
          'updatedAt',
          'updatedByUid',
          'updatedByClientId'
        ])
        && optionalString(data, 'id', 200)
        && optionalNumber(data, 'schemaVersion')
        && optionalNumber(data, 'dayNumber')
        && optionalNumber(data, 'orderKey')
        && optionalString(data, 'time', 40)
        && optionalString(data, 'type', 80)
        && optionalString(data, 'title', 240)
        && optionalString(data, 'desc', 2000)
        && optionalString(data, 'location', 1000)
        && (!data.keys().hasAny(['locationPlace']) || data.locationPlace is map)
        && optionalBool(data, 'urgent')
        && (!data.keys().hasAny(['transport']) || data.transport is map)
        && (!data.keys().hasAny(['cost']) || data.cost is string || data.cost is number || data.cost is map)
        && optionalString(data, 'currency', 16)
        && optionalString(data, 'url', 2000)
        && (!data.keys().hasAny(['memos']) || data.memos is list)
        && optionalBool(data, 'deleted')
        && optionalString(data, 'createdAt', 80)
        && optionalString(data, 'updatedAt', 80)
        && optionalString(data, 'updatedByUid', 160)
        && optionalString(data, 'updatedByClientId', 200);
    }

    function validChecklistItem(data) {
      return data.keys().hasOnly([
          'id',
          'schemaVersion',
          'listId',
          'orderKey',
          'text',
          'done',
          'category',
          'assignedTo',
          'day',
          'deleted',
          'createdAt',
          'updatedAt',
          'updatedByUid',
          'updatedByClientId'
        ])
        && optionalString(data, 'id', 200)
        && optionalNumber(data, 'schemaVersion')
        && optionalString(data, 'listId', 80)
        && optionalNumber(data, 'orderKey')
        && optionalString(data, 'text', 240)
        && optionalBool(data, 'done')
        && optionalString(data, 'category', 120)
        && (!data.keys().hasAny(['assignedTo']) || data.assignedTo == null || data.assignedTo is string)
        && (!data.keys().hasAny(['day']) || data.day == null || data.day is number)
        && optionalBool(data, 'deleted')
        && optionalString(data, 'createdAt', 80)
        && optionalString(data, 'updatedAt', 80)
        && optionalString(data, 'updatedByUid', 160)
        && optionalString(data, 'updatedByClientId', 200);
    }

    function validShoppingItem(data) {
      return data.keys().hasOnly([
          'id',
          'schemaVersion',
          'orderKey',
          'name',
          'category',
          'shop',
          'quantity',
          'notes',
          'image',
          'purchased',
          'deleted',
          'createdAt',
          'updatedAt',
          'updatedByUid',
          'updatedByClientId'
        ])
        && optionalString(data, 'id', 200)
        && optionalNumber(data, 'schemaVersion')
        && optionalNumber(data, 'orderKey')
        && optionalString(data, 'name', 240)
        && optionalString(data, 'category', 200)
        && optionalString(data, 'shop', 240)
        && optionalNumber(data, 'quantity')
        && optionalString(data, 'notes', 4000)
        && (!data.keys().hasAny(['image']) || data.image == null || data.image is string)
        && optionalBool(data, 'purchased')
        && optionalBool(data, 'deleted')
        && optionalString(data, 'createdAt', 80)
        && optionalString(data, 'updatedAt', 80)
        && optionalString(data, 'updatedByUid', 160)
        && optionalString(data, 'updatedByClientId', 200);
    }

    function validExpense(data) {
      return data.keys().hasOnly([
          'id',
          'schemaVersion',
          'orderKey',
          'title',
          'amount',
          'currency',
          'date',
          'category',
          'payer',
          'splitType',
          'involved',
          'isSettled',
          'note',
          'deleted',
          'createdAt',
          'updatedAt',
          'updatedByUid',
          'updatedByClientId'
        ])
        && optionalString(data, 'id', 200)
        && optionalNumber(data, 'schemaVersion')
        && optionalNumber(data, 'orderKey')
        && optionalString(data, 'title', 240)
        && optionalNumber(data, 'amount')
        && optionalString(data, 'currency', 16)
        && optionalString(data, 'date', 80)
        && optionalString(data, 'category', 120)
        && optionalString(data, 'payer', 160)
        && optionalString(data, 'splitType', 80)
        && (!data.keys().hasAny(['involved']) || data.involved is list)
        && optionalBool(data, 'isSettled')
        && optionalString(data, 'note', 2000)
        && optionalBool(data, 'deleted')
        && optionalString(data, 'createdAt', 80)
        && optionalString(data, 'updatedAt', 80)
        && optionalString(data, 'updatedByUid', 160)
        && optionalString(data, 'updatedByClientId', 200);
    }

    function validPlaceIdea(data) {
      return data.keys().hasOnly([
          'id',
          'schemaVersion',
          'orderKey',
          'name',
          'address',
          'placeId',
          'lat',
          'lng',
          'note',
          'status',
          'plannedDay',
          'addedAt',
          'plannedAt',
          'votes',
          'deleted',
          'createdAt',
          'updatedAt',
          'updatedByUid',
          'updatedByClientId'
        ])
        && optionalString(data, 'id', 200)
        && optionalNumber(data, 'schemaVersion')
        && optionalNumber(data, 'orderKey')
        && optionalString(data, 'name', 240)
        && optionalString(data, 'address', 1000)
        && optionalString(data, 'placeId', 240)
        && (!data.keys().hasAny(['lat']) || data.lat == null || data.lat is number)
        && (!data.keys().hasAny(['lng']) || data.lng == null || data.lng is number)
        && optionalString(data, 'note', 2000)
        && optionalString(data, 'status', 80)
        && (!data.keys().hasAny(['plannedDay']) || data.plannedDay == null || data.plannedDay is number)
        && optionalString(data, 'addedAt', 80)
        && optionalString(data, 'plannedAt', 80)
        && (!data.keys().hasAny(['votes']) || data.votes is list)
        && optionalBool(data, 'deleted')
        && optionalString(data, 'createdAt', 80)
        && optionalString(data, 'updatedAt', 80)
        && optionalString(data, 'updatedByUid', 160)
        && optionalString(data, 'updatedByClientId', 200);
    }

    function validShoppingCategory(data) {
      return data.keys().hasOnly([
          'id',
          'schemaVersion',
          'name',
          'orderKey',
          'deleted',
          'createdAt',
          'updatedAt',
          'updatedByUid',
          'updatedByClientId'
        ])
        && optionalString(data, 'id', 200)
        && optionalNumber(data, 'schemaVersion')
        && optionalString(data, 'name', 200)
        && optionalNumber(data, 'orderKey')
        && optionalBool(data, 'deleted')
        && optionalString(data, 'createdAt', 80)
        && optionalString(data, 'updatedAt', 80)
        && optionalString(data, 'updatedByUid', 160)
        && optionalString(data, 'updatedByClientId', 200);
    }

    function editorSafeTripUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'access',
        'collaboration',
        'invite'
      ]);
    }

    match /userProfiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && validUserProfile(request.resource.data);
      allow delete: if false;
    }

    match /userPushSubscriptions/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;

      match /devices/{deviceId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /userNotificationSettings/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;

      match /tripPrefs/{tripId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /{path=**}/members/{memberId} {
      allow list: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /trips/{tripId} {
      allow get: if signedIn()
        && (
          isOwnedByCurrentUser(resource.data)
          || exists(memberPath(tripId, request.auth.uid))
          || (isPrimaryOwner() && !hasOwner(resource.data))
        );

      allow list: if signedIn()
        && (
          isPrimaryOwner()
          || isOwnedByCurrentUser(resource.data)
          || exists(memberPath(tripId, request.auth.uid))
        );

      allow create: if signedIn()
        && validTripRoot(request.resource.data)
        && request.resource.data.access.ownerUid == request.auth.uid
        && request.resource.data.access.ownerEmail == request.auth.token.email;

      allow update: if signedIn()
        && validTripRoot(request.resource.data)
        && (
          isOwnedByCurrentUser(resource.data)
          || (
            isPrimaryOwner()
            && !hasOwner(resource.data)
            && request.resource.data.access.ownerUid == request.auth.uid
          )
          || (
            isTripEditor(tripId)
            && editorSafeTripUpdate()
          )
        );

      allow delete: if signedIn()
        && isOwnedByCurrentUser(resource.data);

      match /members/{uid} {
        allow read: if signedIn()
          && (
            resource.data.uid == request.auth.uid
            || isTripOwner(tripId)
            || exists(memberPath(tripId, request.auth.uid))
          );

        allow create: if signedIn()
          && validMember(request.resource.data, uid)
          && request.resource.data.uid == uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == 'owner'
          && isTripOwnerAfter(tripId);

        allow update: if signedIn()
          && isTripOwner(tripId)
          && validMember(request.resource.data, uid);

        allow delete: if signedIn() && isTripOwner(tripId);

        allow update: if signedIn()
          && uid == request.auth.uid
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && validMember(request.resource.data, uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName',
            'email',
            'photoURL',
            'updatedAt'
          ]);
      }

      match /details/{detailId} {
        allow read: if signedIn()
          && (
            isTripOwner(tripId)
            || exists(memberPath(tripId, request.auth.uid))
          );

        allow create, update: if signedIn()
          && validTripDetail(request.resource.data, detailId)
          && (
            isTripOwner(tripId)
            || isTripEditor(tripId)
          );

        allow delete: if false;
      }

      match /settings/{settingId} {
        allow read: if signedIn()
          && (
            isTripOwner(tripId)
            || exists(memberPath(tripId, request.auth.uid))
          );

        allow create, update: if signedIn()
          && isTripOwner(tripId)
          && validTripSetting(request.resource.data, settingId);

        allow delete: if false;
      }

      match /days/{dayId} {
        allow read: if signedIn()
          && (
            isTripOwner(tripId)
            || exists(memberPath(tripId, request.auth.uid))
          );

        allow create, update: if signedIn()
          && validTripDay(request.resource.data, dayId)
          && (
            isTripOwner(tripId)
            || isTripEditor(tripId)
          );

        allow delete: if false;
      }

      match /events/{eventId} {
        allow read: if signedIn()
          && (
            isTripOwner(tripId)
            || exists(memberPath(tripId, request.auth.uid))
          );

        allow create, update: if signedIn()
          && validTripEvent(request.resource.data)
          && (
            isTripOwner(tripId)
            || isTripEditor(tripId)
          );

        allow delete: if signedIn()
          && (
            isTripOwner(tripId)
            || isTripEditor(tripId)
          );
      }

      match /checklistItems/{itemId} {
        allow read: if signedIn()
          && (
            isTripOwner(tripId)
            || exists(memberPath(tripId, request.auth.uid))
          );

        allow create, update: if signedIn()
          && validChecklistItem(request.resource.data)
          && (
            isTripOwner(tripId)
            || isTripEditor(tripId)
          );

        allow delete: if signedIn()
          && (
            isTripOwner(tripId)
            || isTripEditor(tripId)
          );
      }

      match /shoppingItems/{itemId} {
        allow read: if signedIn()
          && (
            isTripOwner(tripId)
            || exists(memberPath(tripId, request.auth.uid))
          );

        allow create, update: if signedIn()
          && validShoppingItem(request.resource.data)
          && (
            isTripOwner(tripId)
            || isTripEditor(tripId)
          );

        allow delete: if signedIn()
          && (
            isTripOwner(tripId)
            || isTripEditor(tripId)
          );
      }

      match /expenses/{expenseId} {
        allow read: if signedIn()
          && (
            isTripOwner(tripId)
            || exists(memberPath(tripId, request.auth.uid))
          );

        allow create, update: if signedIn()
          && validExpense(request.resource.data)
          && (
            isTripOwner(tripId)
            || isTripEditor(tripId)
          );

        allow delete: if signedIn()
          && (
            isTripOwner(tripId)
            || isTripEditor(tripId)
          );
      }

      match /placeIdeas/{placeId} {
        allow read: if signedIn()
          && (
            isTripOwner(tripId)
            || exists(memberPath(tripId, request.auth.uid))
          );

        allow create, update: if signedIn()
          && validPlaceIdea(request.resource.data)
          && (
            isTripOwner(tripId)
            || isTripEditor(tripId)
          );

        allow delete: if signedIn()
          && (
            isTripOwner(tripId)
            || isTripEditor(tripId)
          );
      }

      match /shoppingCategories/{categoryId} {
        allow read: if signedIn()
          && (
            isTripOwner(tripId)
            || exists(memberPath(tripId, request.auth.uid))
          );

        allow create, update: if signedIn()
          && validShoppingCategory(request.resource.data)
          && (
            isTripOwner(tripId)
            || isTripEditor(tripId)
          );

        allow delete: if signedIn()
          && (
            isTripOwner(tripId)
            || isTripEditor(tripId)
          );
      }
    }

    match /tripShares/{token} {
      allow read, write: if false;
    }

    match /tripInviteCodes/{inviteId} {
      allow read, write: if false;
    }

    match /inviteCodeRateLimits/{uid} {
      allow read, write: if false;
    }

    match /flightLookupRateLimits/{uid} {
      allow read, write: if false;
    }

    match /googleLookupRateLimits/{uid} {
      allow read, write: if false;
    }

    match /emailLoginChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /emailLoginRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /notificationDeliveries/{deliveryId} {
      allow read, write: if false;
    }

    match /appMeta/{documentId} {
      allow read, write: if isPrimaryOwner();
    }
  }
}
