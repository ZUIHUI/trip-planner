# Frontend public runtime config.
# Values with VITE_ are bundled into the browser. Do not put private provider
# keys here. This app pins its Firebase web config in src/services/firebase.js.
VITE_FIREBASE_USE_CURRENT_DOMAIN_AUTH=false
VITE_PRIMARY_OWNER_EMAIL=owner@example.com
VITE_PRIVACY_CONTACT_EMAIL=trip.planner.36455@gmail.com

# Optional public browser key override used by Google Maps Embed API. When it
# is empty, the app reuses its referrer-restricted Firebase web API key, which
# is also enabled for Maps Embed API. Never use the server geocoding secret.
VITE_GOOGLE_MAPS_EMBED_API_KEY=

# Server-only provider configuration. Keep private provider keys in Firebase
# Functions secrets and never prefix them with VITE_.
GOOGLE_GEOCODING_API_KEY=configure_as_firebase_functions_secret_for_places_and_geocoding
OPENAI_API_KEY=configure_as_firebase_functions_secret_for_ai_recommendations
OPENAI_MODEL=gpt-5.6-sol
OPENAI_IMAGE_MODEL=gpt-image-2

# Firebase Functions ordinary parameters.
EMAIL_FROM=Trip Planner <your-gmail@gmail.com>
GMAIL_SMTP_USER=your-gmail@gmail.com
WEB_PUSH_VAPID_PUBLIC_KEY=your_public_vapid_key
WEB_PUSH_VAPID_SUBJECT=mailto:your-gmail@gmail.com

# Firebase Functions secrets.
GMAIL_SMTP_APP_PASSWORD=configure_with_firebase_functions_secrets
EMAIL_CODE_PEPPER=configure_with_firebase_functions_secrets
INVITE_CODE_PEPPER=configure_with_firebase_functions_secrets
WEB_PUSH_VAPID_PRIVATE_KEY=configure_with_firebase_functions_secrets
