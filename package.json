{
  "name": "trip-planner",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "firebase": "^12.6.0",
    "lucide-react": "^0.379.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "functions:install": "cd functions && npm install",
    "functions:lint": "cd functions && npm run lint",
    "presence:backfill": "node functions/scripts/backfillPresenceAcl.js",
    "deploy": "npm run build && firebase deploy --only firestore:rules,database,functions,hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,database",
    "deploy:hosting": "npm run build && firebase deploy --only hosting"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "vite": "^5.0.0"
  }
}
